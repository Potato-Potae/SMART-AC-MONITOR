/* =====================================================
   ตั้งค่าระบบ  (แก้เฉพาะส่วนนี้)
   ===================================================== */
const CONFIG = {

    // true = ใช้ข้อมูลจำลองไว้ลองดูหน้าเว็บ / false = ดึงข้อมูลจริงจาก ESP32
    DEMO: true,

    // ดึงข้อมูลใหม่ทุกกี่มิลลิวินาที (5000 = 5 วินาที)
    INTERVAL: 5000,

    // ใส่ IP ของ ESP32 แต่ละตัว (ดู IP ได้จาก Serial Monitor ตอนบอร์ดต่อ WiFi)
    ACS: [
        { name: "แอร์ 1", url: "http://192.168.1.101/data" },
        { name: "แอร์ 2", url: "http://192.168.1.102/data" },
        { name: "แอร์ 3", url: "http://192.168.1.103/data" },
        { name: "แอร์ 4", url: "http://192.168.1.104/data" }
    ],

    // กระแสตั้งแต่เท่านี้ (แอมป์) ขึ้นไป = แอร์เปิดอยู่
    ON_CURRENT: 0.5,

    // เกณฑ์แจ้งเตือน
    VOLT_MIN: 200,      // แรงดันต่ำกว่านี้ (V) แจ้งเตือน
    VOLT_MAX: 245,      // แรงดันสูงกว่านี้ (V) แจ้งเตือน
    CURRENT_MAX: 15,    // กระแสเกินนี้ (A) แจ้งเตือน
    TEMP_MAX: 30        // แอร์เปิดอยู่แต่ห้องร้อนเกินนี้ (°C) แจ้งเตือน
};


/* =====================================================
   ด้านล่างนี้ไม่ต้องแก้
   ===================================================== */
const STATE_TEXT = { on: "เปิดอยู่", off: "ปิดอยู่", offline: "ออฟไลน์" };

// แสดงตัวเลข ถ้าไม่มีค่าให้ขึ้น --
function fmt(v, dec) {
    return (v === null || v === undefined || isNaN(v)) ? "--" : Number(v).toFixed(dec);
}

// ข้อมูลจำลอง (ใช้ตอน DEMO = true)
function demoData(i) {
    const t = Date.now() / 1000;
    if (i === 0) return { voltage: 229.8 + Math.sin(t) * 1.2, current: 4.5 + Math.sin(t / 3) * 0.3, power: 980, energy: 12.84, freq: 50.0, pf: 0.95, temp: 25.5 };
    if (i === 1) return { voltage: 231.2 + Math.sin(t) * 1.2, current: 6.1 + Math.sin(t / 4) * 0.4, power: 1350, energy: 33.5, freq: 50.0, pf: 0.96, temp: 27.2 };
    if (i === 2) return { voltage: 230.4, current: 0.02, power: 1, energy: 8.1, freq: 50.0, pf: 0.4, temp: 29.0 };
    return null; // แอร์ 4 จำลองว่าออฟไลน์
}

// ดึงข้อมูลแอร์ 1 ตัว แล้วสรุปสถานะ + คำเตือน
async function loadAC(i) {
    const name = CONFIG.ACS[i].name;
    let d = null;

    if (CONFIG.DEMO) {
        d = demoData(i);
    } else {
        try {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 3000);
            const res = await fetch(CONFIG.ACS[i].url, { signal: ctrl.signal, cache: "no-store" });
            clearTimeout(timer);
            if (res.ok) d = await res.json();
        } catch (e) { d = null; }
    }

    if (!d) {
        return { state: "offline", data: null, warnings: [name + ": ติดต่อ ESP32 ไม่ได้ (ออฟไลน์)"] };
    }

    const on = d.current !== null && d.current >= CONFIG.ON_CURRENT;
    const warnings = [];

    if (d.voltage === null) warnings.push(name + ": อ่านค่าแรงดันจาก PZEM ไม่ได้ (เช็คสายต่อ)");
    else if (d.voltage < CONFIG.VOLT_MIN) warnings.push(name + ": แรงดันต่ำ " + fmt(d.voltage, 1) + " V");
    else if (d.voltage > CONFIG.VOLT_MAX) warnings.push(name + ": แรงดันสูง " + fmt(d.voltage, 1) + " V");

    if (d.current !== null && d.current > CONFIG.CURRENT_MAX) warnings.push(name + ": กระแสสูง " + fmt(d.current, 2) + " A");
    if (on && d.temp !== null && d.temp > CONFIG.TEMP_MAX) warnings.push(name + ": แอร์เปิดอยู่แต่ห้องร้อน " + fmt(d.temp, 1) + " °C");

    return { state: on ? "on" : "off", data: d, warnings: warnings };
}

// อัปเดตจุดสีในแถบเมนู
function updateDots(results) {
    results.forEach((r, i) => {
        const dot = document.getElementById("dot" + (i + 1));
        if (dot) dot.className = "mini-dot " + r.state;
    });
}

// แสดงกล่องแจ้งเตือน
function showAlerts(warnings) {
    const box = document.getElementById("alerts");
    if (!box) return;
    if (warnings.length === 0) { box.className = "alerts"; box.innerHTML = ""; return; }
    box.className = "alerts show";
    box.innerHTML = "<strong>⚠️ แจ้งเตือน</strong>" + warnings.map(w => "<div>• " + w + "</div>").join("");
}

function nowTime() {
    return new Date().toLocaleTimeString("th-TH", { hour12: false });
}
